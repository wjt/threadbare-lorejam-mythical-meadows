[sub_resource type="GDScript" id="GDScript_wcnst"]
resource_name = "barnaby_store"
script/source = "extends Node2D

const DIALOGUE_RESOURCE = preload(\"res://scenes/quests/lore_quests/quest_004/Intro/intro.dialogue\")
@export var siguiente_escena: PackedScene

@onready var barnaby: CharacterBody2D = $Barnaby
@onready var player: CharacterBody2D = $Player 

func _ready() -> void:
	# Disparamos el monólogo de Wiñay automáticamente al entrar a la tienda
	iniciar_monologo_entrada()

func iniciar_monologo_entrada() -> void:
	# Esperamos un frame para garantizar que toda la escena cargó correctamente
	await get_tree().process_frame
	
	# Congelamos a Wiñay mientras habla solo
	if player:
		player.velocity = Vector2.ZERO
		if player.has_node(\"AnimatedSprite2D\"):
			player.get_node(\"AnimatedSprite2D\").play(\"idle\")
		if player.has_method(\"set_physics_process\"):
			player.set_physics_process(false)
			
	# Mostramos el bloque donde Wiñay piensa en voz alta sobre el conejo
	DialogueManager.show_dialogue_balloon(DIALOGUE_RESOURCE, \"monologo_entrada_tienda\")
	await DialogueManager.dialogue_ended
	
	# Le devolvemos el control físico para que pueda explorar y caminar hacia Barnaby
	if player and player.has_method(\"set_physics_process\"):
		player.set_physics_process(true)

func _unhandled_input(event: InputEvent) -> void:
	# Verificamos si Barnaby existe y si el jugador está en su rango
	if barnaby and \"jugador_cerca\" in barnaby and barnaby.jugador_cerca:
		if not barnaby.dialogo_hecho:
			if event.is_action_pressed(\"dialogue_next\") or (event is InputEventKey and event.pressed and event.keycode == KEY_SPACE):
				get_viewport().set_input_as_handled()
				iniciar_dialogo_barnaby()

func iniciar_dialogo_barnaby() -> void:
	barnaby.dialogo_hecho = true
	
	# Apagamos la flecha flotante
	if barnaby.has_node(\"IndicadorVisual\"):
		barnaby.get_node(\"IndicadorVisual\").visible = false
		
	# Frenamos a Wiñay (gnomo)
	if player:
		player.velocity = Vector2.ZERO
		if player.has_node(\"AnimatedSprite2D\"):
			player.get_node(\"AnimatedSprite2D\").play(\"idle\")
		if player.has_method(\"set_physics_process\"):
			player.set_physics_process(false)
	
	# Cambiamos la animación de Barnaby a hablar misterioso
	if barnaby.has_node(\"AnimatedSprite2D\"):
		barnaby.get_node(\"AnimatedSprite2D\").play(\"talk\")
		
	# Disparamos el diálogo de la presentación y la Flor de Seda Eterna
	DialogueManager.show_dialogue_balloon(DIALOGUE_RESOURCE, \"encuentro_barnaby\")
	await DialogueManager.dialogue_ended

	# Barnaby vuelve a su animación quieta al terminar de hablar
	if barnaby.has_node(\"AnimatedSprite2D\"):
		barnaby.get_node(\"AnimatedSprite2D\").play(\"idle\")

	# Pequeña pausa dramática antes de la transición
	await get_tree().create_timer(0.5).timeout

	# Cambiamos a la siguiente escena del desafío si está configurada en el inspector
	if siguiente_escena:
		GameState.set_challenge_start_scene(siguiente_escena.resource_path)
		SceneSwitcher.change_to_file_with_transition(siguiente_escena.resource_path)
"

[sub_resource type="GDScript" id="GDScript_kqrjm"]
resource_name = "player"
script/source = "extends CharacterBody2D

const SPEED = 150.0

@onready var animated_sprite = $AnimatedSprite2D

func _physics_process(_delta):
	var direction = Input.get_vector(
		\"ui_left\",
		\"ui_right\",
		\"ui_up\",
		\"ui_down\"
	)

	# Agregar soporte WASD
	if Input.is_key_pressed(KEY_A):
		direction.x -= 1
	if Input.is_key_pressed(KEY_D):
		direction.x += 1
	if Input.is_key_pressed(KEY_W):
		direction.y -= 1
	if Input.is_key_pressed(KEY_S):
		direction.y += 1

	direction = direction.normalized()

	if direction != Vector2.ZERO:
		velocity = direction * SPEED
		animated_sprite.play(\"walk\")
		
		if direction.x != 0:
			animated_sprite.flip_h = direction.x < 0
	else:
		velocity = Vector2.ZERO
		animated_sprite.play(\"idle\")

	move_and_slide()
"

